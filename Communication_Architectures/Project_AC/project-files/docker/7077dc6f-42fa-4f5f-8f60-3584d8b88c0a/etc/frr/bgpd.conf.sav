!
! Zebra configuration saved from vty
!   2026/01/08 03:03:37
!
frr version 8.4_git
frr defaults traditional
!
hostname S2
!
!
!
router bgp 22900
 neighbor LEAVES peer-group
 neighbor LEAVES remote-as 22900
 neighbor LEAVES update-source 10.0.0.102
 neighbor 10.0.0.6 peer-group LEAVES
 neighbor 10.0.0.16 peer-group LEAVES
 neighbor 10.0.0.26 peer-group LEAVES
 neighbor 10.0.0.101 remote-as 22900
 neighbor 10.0.0.101 update-source 10.0.0.102
 !
 address-family ipv4 unicast
  neighbor LEAVES route-reflector-client
 exit-address-family
 !
 address-family l2vpn evpn
  neighbor LEAVES activate
  neighbor LEAVES route-reflector-client
  neighbor 10.0.0.101 activate
 exit-address-family
!
exit
!
!
!
!
